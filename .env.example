# Discord bot credentials — copy this file to .env and fill the values
# Token: Discord Developer Portal → Bot → Reset Token
TOKEN=
# Application ID: Discord Developer Portal → General Information → Application ID
CLIENT_ID=
# Optional: register slash commands instantly to one guild (recommended for a single support server)
GUILD_ID=
# Optional: override database file name (default: exams.sqlite inside ./data)
# DB_FILE=exams.sqlite
